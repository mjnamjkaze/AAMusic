<?xml version="1.0" encoding="utf-8"?>
<!--
  Dấu hiệu nhận diện DriveTune: vành vô-lăng chuyển sắc cam→đỏ, hai nan ngang,
  bên trong là một nốt nhạc trắng — nhìn là biết "nghe nhạc trên ô tô".

  Ràng buộc khi vẽ:
   - Mọi nét nằm trong vùng an toàn của adaptive icon (hình tròn đường kính 66dp
     quanh tâm 54,54): vành ngoài chạm bán kính 32 < 33, nên launcher bo tròn,
     bo góc hay hình giọt nước đều không cắt mất.
   - Hai nan vô-lăng ở y=45, còn nốt nhạc bắt đầu từ y≈49 — chừa khoảng hở để ở
     cỡ 48dp chúng không dính thành một mảng.
   - Chỉ hai tông màu (cam của vành, trắng của nốt): thêm chi tiết nữa là icon
     thành vệt mờ khi thu nhỏ.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vành vô-lăng -->
    <path
        android:pathData="M26,54a28,28 0 1,0 56,0a28,28 0 1,0 -56,0"
        android:strokeWidth="7.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="26"
                android:endX="80"
                android:endY="82">
                <item android:offset="0" android:color="#FFFFA24B" />
                <item android:offset="0.5" android:color="#FFFF5A36" />
                <item android:offset="1" android:color="#FFE01F3D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Nan ngang trái / phải -->
    <path
        android:pathData="M28.5,46 L38,46"
        android:strokeColor="#FFFF7A42"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M70,46 L79.5,46"
        android:strokeColor="#FFF03A2E"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- Nốt nhạc: đầu nốt, thân, móc. Hơi ngả trắng-xanh ở đáy cho có khối. -->
    <path android:pathData="M46.5,60m-8,0a8,8 0 1,0 16,0a8,8 0 1,0 -16,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="38.5"
                android:startY="52"
                android:endX="54.5"
                android:endY="68">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFDCE4F2" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M50.5,60 L50.5,37 L56,37 L56,60Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M56,37 Q64,39.6 67.4,45.8 Q68.4,47.7 66.5,48.3 Q64.6,48.9 63.6,47.1 Q61,42.5 56,40.7Z" />

</vector>
