<?xml version="1.0" encoding="utf-8"?>
<!--
  Drive Mode, bản màn hình ngang — chính là hình dạng của màn hình xe
  (Android Auto thường 800x480). Xếp ảnh bìa sang trái, chữ và nút sang phải để
  nút vẫn to bằng bản dọc thay vì bị bóp dẹp.

  Id giữ nguyên hệt bản dọc: DriveMode.kt không cần biết đang ở hướng nào.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/driveRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/drive_background"
    android:orientation="horizontal"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <!-- ── Ảnh bìa ── -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.9"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/drive_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/driveArtwork"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note"
                app:tint="@color/drive_text_dim" />

            <!-- Tốc độ xe (tuỳ chọn), đè lên ảnh bìa / hình nền. -->
            <LinearLayout
                android:id="@+id/driveSpeedBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/driveSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:shadowColor="#B3000000"
                    android:shadowDy="2"
                    android:shadowRadius="16"
                    android:text="@string/drive_speed_unknown"
                    android:textColor="@color/drive_text"
                    android:textSize="@dimen/drive_speed_text"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#B3000000"
                    android:shadowDy="2"
                    android:shadowRadius="12"
                    android:text="@string/drive_speed_unit"
                    android:textColor="@color/drive_text"
                    android:textSize="@dimen/drive_title_text"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- ── Chữ + điều khiển ── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_drive_mode"
                app:tint="@color/drive_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:text="@string/drive_mode_title"
                android:textColor="@color/drive_text_dim"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/driveExit"
                android:layout_width="@dimen/drive_small_button"
                android:layout_height="@dimen/drive_small_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/drive_mode_exit"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_drive_exit"
                app:tint="@color/drive_text_dim" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/driveTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/drive_nothing_playing"
            android:textColor="@color/drive_text"
            android:textSize="@dimen/drive_title_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/driveChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/drive_text_dim"
            android:textSize="@dimen/drive_subtitle_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/drivePosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:textColor="@color/drive_text_dim"
                android:textSize="13sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/driveProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                app:indicatorColor="@color/drive_accent"
                app:trackColor="@color/drive_surface"
                app:trackCornerRadius="3dp"
                app:trackThickness="6dp" />

            <TextView
                android:id="@+id/driveDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="44dp"
                android:textColor="@color/drive_text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/drivePrev"
                android:layout_width="@dimen/drive_side_button"
                android:layout_height="@dimen/drive_side_button"
                android:background="@drawable/drive_button_bg"
                android:contentDescription="@string/bubble_prev"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/drive_text" />

            <ImageButton
                android:id="@+id/drivePlayPause"
                android:layout_width="@dimen/drive_play_button"
                android:layout_height="@dimen/drive_play_button"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/drive_play_bg"
                android:contentDescription="@string/bubble_play_pause"
                android:padding="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="@color/drive_on_accent" />

            <ImageButton
                android:id="@+id/driveNext"
                android:layout_width="@dimen/drive_side_button"
                android:layout_height="@dimen/drive_side_button"
                android:background="@drawable/drive_button_bg"
                android:contentDescription="@string/bubble_next"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/drive_text" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/driveFavorite"
                android:layout_width="@dimen/drive_small_button"
                android:layout_height="@dimen/drive_small_button"
                android:background="@drawable/drive_button_bg"
                android:contentDescription="@string/drive_favorite"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/favorite_24px"
                app:tint="@color/drive_text" />

            <ImageButton
                android:id="@+id/driveQueue"
                android:layout_width="@dimen/drive_small_button"
                android:layout_height="@dimen/drive_small_button"
                android:layout_marginStart="10dp"
                android:background="@drawable/drive_button_bg"
                android:contentDescription="@string/drive_queue"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_queue"
                app:tint="@color/drive_text" />

            <ImageButton
                android:id="@+id/driveVolume"
                android:layout_width="@dimen/drive_small_button"
                android:layout_height="@dimen/drive_small_button"
                android:layout_marginStart="10dp"
                android:background="@drawable/drive_button_bg"
                android:contentDescription="@string/drive_volume"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_volume"
                app:tint="@color/drive_text" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
