<?xml version="1.0" encoding="utf-8"?>
<!-- Một danh sách dựng sẵn. Hàng cao, chữ to — chạm một lần là phát. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/playlistIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/drive_button_bg"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_music_note"
        app:tint="@color/drive_accent" />

    <TextView
        android:id="@+id/playlistName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/drive_text"
        android:textSize="17sp" />

    <ImageButton
        android:id="@+id/playlistDefault"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_default_playlist"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_pin"
        app:tint="@color/drive_text_dim" />

</LinearLayout>
