<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Collapsed: draggable circle -->
    <ImageView
        android:id="@+id/bubbleCollapsed"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bubble_circle_bg"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@drawable/ic_music_note"
        android:contentDescription="@string/app_name" />

    <!-- Expanded: control bar -->
    <LinearLayout
        android:id="@+id/bubbleExpanded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_card_bg"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bubbleTitle"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bubble_playing"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bubble_btn_ripple"
            android:contentDescription="@string/bubble_prev"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bubble_btn_ripple"
            android:contentDescription="@string/bubble_play_pause"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bubble_btn_ripple"
            android:contentDescription="@string/bubble_next"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/btnVoice"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bubble_btn_ripple"
            android:contentDescription="@string/voice_search"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:src="@drawable/ic_mic" />

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bubble_btn_ripple"
            android:contentDescription="@string/bubble_search"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:src="@drawable/ic_search_white" />

        <ImageButton
            android:id="@+id/btnOpen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bubble_btn_ripple"
            android:contentDescription="@string/bubble_open"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:src="@drawable/ic_open_app" />

        <ImageButton
            android:id="@+id/btnCollapse"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bubble_btn_ripple"
            android:contentDescription="@string/bubble_collapse"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:src="@drawable/ic_collapse" />

    </LinearLayout>

</FrameLayout>
