<?xml version="1.0" encoding="utf-8"?>
<!--
  Cài đặt. Cố tình ngắn: bảy công tắc, hai dòng chọn (danh sách, hình nền),
  một dòng dọn bộ nhớ, một dòng ủng hộ tác giả.
  Mỗi hàng cao 56dp trở lên để chạm được cả khi xe đang chạy.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="@dimen/menu_max_height">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/drag_handle_background" />

        <TextView
            style="@style/DriveSettingsHeader"
            android:text="@string/settings_section_driving" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDriveOnStart"
            style="@style/DriveSettingsSwitch"
            android:text="@string/settings_drive_on_start" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchResume"
            style="@style/DriveSettingsSwitch"
            android:text="@string/settings_resume" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchCarResume"
            style="@style/DriveSettingsSwitch"
            android:text="@string/settings_car_resume" />

        <TextView
            android:id="@+id/defaultPlaylistRow"
            style="@style/DriveSettingsRow"
            android:drawablePadding="16dp"
            app:drawableStartCompat="@drawable/ic_queue" />

        <TextView
            style="@style/DriveSettingsHeader"
            android:text="@string/settings_section_playback" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchVoice"
            style="@style/DriveSettingsSwitch"
            android:text="@string/settings_voice" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchShowVideo"
            style="@style/DriveSettingsSwitch"
            android:text="@string/settings_show_video" />

        <TextView
            android:id="@+id/playerBgRow"
            style="@style/DriveSettingsRow"
            android:drawablePadding="16dp"
            app:drawableStartCompat="@drawable/ic_wallpaper" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDataSaver"
            style="@style/DriveSettingsSwitch"
            android:text="@string/settings_data_saver" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchForceDark"
            style="@style/DriveSettingsSwitch"
            android:text="@string/settings_force_dark" />

        <TextView
            android:id="@+id/clearDataRow"
            style="@style/DriveSettingsRow"
            android:drawablePadding="16dp"
            android:text="@string/settings_clear_data"
            app:drawableStartCompat="@drawable/delete_forever_24px" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/colorSurfaceVariant" />

        <!-- ── Cập nhật: chỉ hiện khi GitHub có bản mới hơn (AppUpdate) ── -->
        <TextView
            android:id="@+id/updateRow"
            style="@style/DriveSettingsRow"
            android:drawablePadding="16dp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/refresh_24px"
            app:drawableTint="?attr/colorPrimary" />

        <!-- ── Ủng hộ tác giả (chuyển khoản VietQR) ── -->
        <LinearLayout
            android:id="@+id/aboutRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bubble_circle_bg"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/volunteer_activism_24px"
                app:tint="#FFFFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/donate_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/donate_subtitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/donate_account_short"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/aboutVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
