<?xml version="1.0" encoding="utf-8"?>
<!-- Ủng hộ tác giả: mã VietQR BIDV + tên, số tài khoản. Nền trắng cố định để
     app ngân hàng quét được cả khi máy đang ở chế độ tối. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <ImageView
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="#FFFFFFFF"
        android:contentDescription="@string/donate_title"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/donate_qr" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/donate_name"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/donate_account"
        android:textColor="?attr/colorOnSurface"
        android:textIsSelectable="true"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/donate_bank"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/donate_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />
</LinearLayout>
