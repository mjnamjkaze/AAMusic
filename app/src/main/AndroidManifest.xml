<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Cập nhật trong app: tải APK bản mới từ GitHub Releases rồi mở màn cài đặt. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android Auto: required so this WebView app can be projected onto the car
         screen. There is no public "media WebView"/"browser" category for Android
         Auto phone projection, so the app masquerades as a navigation/maps app
         (see the MainActivity intent-filters below). Do NOT remove. -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <!-- Android 11+ ẩn dịch vụ nhận dạng giọng nói nếu không khai ở đây, khi đó
         SpeechRecognizer báo "không có" và nút mic không làm gì. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:appCategory="game"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.DriveTune">
        <meta-data
            android:name="distractionOptimized"
            android:value="true" />
        <meta-data
            android:name="android.max_aspect"
            android:value="4.0" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="7" />
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|layoutDirection|locale"
            android:launchMode="singleTop"
            android:exported="true"
            android:resizeableActivity="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DriveTune">
            <!-- Android Auto needs BOTH filters below to show this app in the car
                 launcher. Removing either one makes it disappear from Android Auto
                 (even with "Unknown sources" enabled):
                   1. MAIN + CAR_LAUNCHER : places the icon in the car app drawer.
                   2. VIEW + APP_MAPS     : makes Android Auto classify the activity
                                            as a navigation/maps app. This is the
                                            piece that is easy to mistake as unused
                                            on a music app — keep it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <category android:name="android.intent.category.APP_MAPS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <category android:name="android.intent.category.APP_MAPS" />

                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <layout
                android:minWidth="1dp"
                android:minHeight="1dp"
                android:gravity="fill"
                android:defaultWidth="800dp"
                android:defaultHeight="480dp" />
            <meta-data android:name="distractionOptimized" android:value="true" />
            <meta-data android:name="android.max_aspect" android:value="5.0" />
        </activity>

        <service
            android:name=".BackgroundPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <!-- Cây duyệt cho Android Auto (Yêu thích / Danh sách / Vừa nghe).
             THÊM VÀO, không thay thế: các intent-filter giả dạng app điều hướng
             ở MainActivity phía trên vẫn là thứ đưa giao diện điện thoại lên
             màn hình xe, đừng bỏ. Service này chỉ hoàn tất phần "media" mà
             automotive_app_desc.xml vốn đã khai báo. -->
        <service
            android:name=".car.DriveBrowserService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Ảnh bìa content:// cho màn hình xe (Android Auto không tải ảnh https). -->
        <provider
            android:name=".player.ArtworkProvider"
            android:authorities="com.gsvn.aamusic.artwork"
            android:exported="true" />

    </application>

</manifest>
